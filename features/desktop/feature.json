{
  "id": "desktop",
  "kind": "helper",
  "version": "0.0.0",
  "platforms": ["linux", "windows", "macos"],
  "commands": [
    {"name":"desktop.info","description":"Probe desktop helper capability, monitors, and session state","risk_level":"low","input_schema":{"type":"object","properties":{},"additionalProperties":false},"requires_approval":false},
    {"name":"desktop.screenshot","description":"Capture a display or region as a PNG artifact","risk_level":"high","input_schema":{"type":"object","properties":{"display":{"type":"integer","minimum":0},"region":{"type":"object","required":["x","y","width","height"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"}},"additionalProperties":false}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.move","description":"Move the mouse cursor","risk_level":"high","input_schema":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"relative":{"type":"boolean"},"display":{"type":"integer","minimum":0}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.click","description":"Click the mouse","risk_level":"high","input_schema":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"button":{"type":"string","enum":["left","right","middle"]},"count":{"type":"integer","minimum":1,"maximum":3},"display":{"type":"integer","minimum":0}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.scroll","description":"Scroll the mouse wheel","risk_level":"high","input_schema":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"dx":{"type":"integer"},"dy":{"type":"integer"},"delta":{"type":"integer"},"display":{"type":"integer","minimum":0}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.drag","description":"Drag the mouse from one point to another","risk_level":"high","input_schema":{"type":"object","required":["from","to"],"properties":{"from":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"}}},"to":{"type":"object","required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"}}},"button":{"type":"string","enum":["left","right","middle"]},"duration_ms":{"type":"integer","minimum":0},"display":{"type":"integer","minimum":0}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.type","description":"Type Unicode text","risk_level":"high","input_schema":{"type":"object","required":["text"],"properties":{"text":{"type":"string","minLength":1},"delay_ms":{"type":"integer","minimum":0}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.key","description":"Press, release, or tap a key combo","risk_level":"high","input_schema":{"type":"object","required":["key"],"properties":{"key":{"type":"string","minLength":1},"modifiers":{"type":"array","items":{"type":"string"}},"action":{"type":"string","enum":["press","release","tap"]}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.clipboard.get","description":"Read clipboard text or image","risk_level":"high","input_schema":{"type":"object","properties":{"format":{"type":"string","enum":["text","image"]}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.clipboard.set","description":"Write clipboard text or image","risk_level":"high","input_schema":{"type":"object","properties":{"text":{"type":"string"},"artifact_id":{"type":"string","format":"uuid"},"sha256":{"type":"string"},"format":{"type":"string"}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.session.open","description":"Open a persistent desktop capture session","risk_level":"high","input_schema":{"type":"object","properties":{"session_id":{"type":"string","format":"uuid"},"fps":{"type":"integer","minimum":1,"maximum":10},"max_duration_secs":{"type":"integer","minimum":30,"maximum":3600},"display":{"type":"integer","minimum":0},"format":{"type":"string","enum":["png","jpeg"]}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.session.frame","description":"Fetch the latest frame from a desktop session","risk_level":"high","input_schema":{"type":"object","required":["session_id"],"properties":{"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.session.input","description":"Send a batch of input events to a desktop session","risk_level":"high","input_schema":{"type":"object","required":["session_id","events"],"properties":{"session_id":{"type":"string","format":"uuid"},"events":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object"}}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.session.close","description":"Close a desktop capture session","risk_level":"high","input_schema":{"type":"object","required":["session_id"],"properties":{"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.app.launch","description":"Launch an application in the GUI session","risk_level":"high","input_schema":{"type":"object","properties":{"app":{"type":"string"},"args":{"type":"array","items":{"type":"string"}},"cwd":{"type":"string"},"wait_window_ms":{"type":"integer"}},"required":["app"],"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.window.list","description":"List visible windows in the GUI session","risk_level":"low","input_schema":{"type":"object","properties":{"include_hidden":{"type":"boolean"}},"additionalProperties":false},"requires_approval":false},
    {"name":"desktop.window.focus","description":"Focus a window by id, title, or app","risk_level":"high","input_schema":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"app":{"type":"string"}},"additionalProperties":false},"requires_approval":true},
    {"name":"desktop.window.wait","description":"Wait until a matching window appears or is focused","risk_level":"low","input_schema":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"app":{"type":"string"},"timeout_ms":{"type":"integer"},"state":{"type":"string","enum":["visible","focused"]}},"additionalProperties":false},"requires_approval":false},
    {"name":"desktop.shell.run","description":"Run an explicit argv process inside the GUI user session","risk_level":"high","input_schema":{"type":"object","properties":{"argv":{"type":"array","items":{"type":"string"},"minItems":1},"cwd":{"type":"string"},"env":{"type":"object","additionalProperties":{"type":"string"}},"timeout_secs":{"type":"integer"}},"required":["argv"],"additionalProperties":false},"requires_approval":true}
  ],
  "mcp": {"skills": ["desktop-commands"], "rules": []},
  "artifacts": [],
  "helper": {"binary":"hecate-lampad-desktop","privilege":"user","socket":"desktop.sock","tags":["desktop"]},
  "depends_on": [{"id":"agent","min_version":"1.0.0"}]
}
