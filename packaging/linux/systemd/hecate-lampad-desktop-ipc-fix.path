[Unit]
Description=Watch hecate-lampad desktop IPC socket for group repair
Documentation=https://github.com/codebfu/hecate-lampad-desktop

[Path]
PathExists=/run/hecate-lampad/desktop.sock
PathChanged=/run/hecate-lampad/desktop.sock
Unit=hecate-lampad-desktop-ipc-fix.service

[Install]
WantedBy=multi-user.target
