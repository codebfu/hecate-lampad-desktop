[Unit]
Description=Fix hecate-lampad desktop IPC socket/token group
Documentation=https://github.com/codebfu/hecate-lampad-desktop
After=hecate-lampad.service

[Service]
Type=oneshot
# No RemainAfterExit: PathChanged on desktop.ipc-fix is edge-triggered, so
# each helper recreate must re-run ExecStart. RemainAfterExit previously
# prevented re-chgrp after sock recreate → sticky gui:none.
ExecStart=/usr/lib/hecate-lampad-desktop/fix-ipc-perms.sh
