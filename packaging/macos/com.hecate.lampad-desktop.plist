<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hecate.lampad-desktop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/hecate-lampad-desktop</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/hecate-lampad-desktop.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hecate-lampad-desktop.err</string>
</dict>
</plist>
